<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="report_invoice_document_state_change_registry"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <style>
                .state-change-table th,
                .state-change-table td {
                    padding: 8px !important;
                }
            </style>
            <table class="table table-sm table-bordered mt-3 table-striped state-change-table">
                <thead class="thead-dark">
                    <tr>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Fecha</th>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Usuario</th>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Estado previo</th>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Estado nuevo</th>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Monto</th>
                        <th style="font-weight: bold; width: 10%; text-align: center; vertical-align: center; color: white; background-color: #342f2b;">Cantidad de lineas</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.state_change_registry_ids" t-as="line">
                        <td>
                            <span t-field="line.change_date"/>
                        </td>
                        <td>
                            <span t-field="line.user_id"/>
                        </td>
                        <td style="text-align: center;">
                            <span t-field="line.previous_state"/>
                        </td>
                        <td style="text-align: center;">
                            <span t-field="line.new_state"/>
                        </td>
                        <td class="text-right" style="text-align: right;">
                            <span t-field="line.amount"/>
                        </td>
                        <td class="text-right" style="text-align: right;">
                            <span class="text-right" style="text-align: right;" t-field="line.line_count"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
