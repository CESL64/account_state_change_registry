<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_invoice_state_change_notification" model="mail.template">
        <field name="name">Notificacion cambio de estado de factura</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">Cambio de estado en factura {{ object.name or object.display_name }}</field>
        <field name="email_from">{{ user.email_formatted or object.company_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-size: 13px;">
                <p>Hola,</p>
                <p>Se ha registrado un cambio de estado en la factura <strong>{{ object.name or object.display_name }}</strong>.</p>
                <p><strong>Registro:</strong> {{ ctx.get('state_change_name') or '' }}</p>
                <p><strong>Fecha de cambio:</strong> {{ ctx.get('change_date') or '' }}</p>
                <p><strong>Estado previo:</strong> {{ ctx.get('previous_state') or '' }}</p>
                <p><strong>Estado nuevo:</strong> {{ ctx.get('new_state') or '' }}</p>
                <p><strong>Monto:</strong> {{ ctx.get('amount') or '' }}</p>
                <p><strong>Cantidad de lineas:</strong> {{ ctx.get('line_count') or '' }}</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
